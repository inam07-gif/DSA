# This Part of code is Insertion Sort

arr = [5,2,4,6,1,3]   # ELEMENTS

for i in range(1, len(arr)):
    key = arr[i]
    j = i - 1
# Left side is sorted, right side is unsorted
# We pick one element key and place it correctly in sorted part

    while j >= 0 and arr[j] > key:
        arr[j+1] = arr[j]   # shift larger element to the right
        j -= 1

# After shifting all larger elements, place key at correct position
    arr[j+1] = key
print(arr)
